# =========================================================
# TicketMind RAG service environment template
# Copy to .env and fill in real values. .env is gitignored.
# =========================================================

# Bind address / port for uvicorn.
RAG_SERVICE_HOST=0.0.0.0
RAG_SERVICE_PORT=8000

# Postgres connection string (pgvector-enabled). In docker-compose this points
# at the shared TicketMind database; in local dev pointing at a dedicated
# database is fine as long as the `vector` extension is installed.
DATABASE_URL=postgresql://ticketmind:ticketmind@localhost:5432/ticketmind

# Shared secret the Spring backend sends on the X-Internal-Key header.
# Generate with: openssl rand -hex 32
RAG_INTERNAL_API_KEY=replace_with_random_hex_32

# Anthropic Claude for triage generation.
ANTHROPIC_API_KEY=sk-ant-replace-me
RAG_CHAT_MODEL=claude-opus-5

# Voyage AI for embeddings. voyage-3 emits 1024-dim vectors which matches the
# `vector(1024)` column in the V2 Flyway migration; changing models means a
# new column and a re-embed job.
VOYAGE_API_KEY=
RAG_EMBEDDING_MODEL=voyage-3

# How many neighbours to retrieve when composing a triage prompt.
RAG_RETRIEVAL_K=5
