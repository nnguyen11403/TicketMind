# =========================================================
# TicketMind environment template
# Copy to .env and fill in real values. .env is gitignored.
# =========================================================

# -------- LLM provider (Anthropic Claude) --------
ANTHROPIC_API_KEY=sk-ant-replace-me
# Optional: embeddings provider. Voyage is recommended for Anthropic stacks.
VOYAGE_API_KEY=
# Optional fallback embeddings provider.
OPENAI_API_KEY=

# -------- Postgres (with pgvector) --------
# The OWNING credential. Used by Flyway to migrate and by nothing else: the
# backend and the RAG service each connect as their own unprivileged role.
POSTGRES_USER=ticketmind
# Replace with a strong random password before running.
POSTGRES_PASSWORD=replace_with_strong_random_password
POSTGRES_DB=ticketmind
# Published on 127.0.0.1 only — see docker-compose.yml.
POSTGRES_PORT=5432

# Passwords for the two least-privilege login roles the V3 migration creates.
# Use hex: these are interpolated into a SQL literal in the migration and into
# the RAG service's DATABASE_URL, so a quote or a '/' would corrupt one of them.
#   openssl rand -hex 32
# ticketmind_app: the backend's runtime role. Owns no table and has no
# BYPASSRLS, which is what makes the row-level security policies apply to it.
APP_DB_PASSWORD=replace_with_random_hex_32
# ticketmind_rag: the RAG service's role. Can create and own kb_documents and
# nothing else — it cannot read tickets, users, or refresh tokens.
RAG_DB_PASSWORD=replace_with_random_hex_32

# -------- Backend (Spring Boot) --------
BACKEND_PORT=8080
# CHANGE THIS FOR A REAL DEPLOYMENT. The `dev` profile turns off Secure on the
# refresh cookie (so http://localhost works) and turns on DEBUG logging. Any
# value other than `dev` or `test` restores Secure cookies, INFO logging, and
# the https channel requirement. `prod` is the conventional choice.
SPRING_PROFILES_ACTIVE=dev
# 64+ random chars. Generate with: openssl rand -base64 64
JWT_SECRET=replace_with_at_least_64_random_chars_openssl_rand_base64_64
# Column-level encryption for ticket titles, bodies, suggested resolutions and
# the audit payloads that carry comment text — plus the same fields on the RAG
# service's knowledge-base mirror, which is why both services receive it.
# Exactly 32 bytes, base64-encoded:  openssl rand -base64 32
# Back this up somewhere other than the database. Lose it and every encrypted
# ticket is gone; rotating it means re-encrypting, which the v1: prefix on
# stored values exists to make possible.
APP_ENCRYPTION_KEY=replace_with_openssl_rand_base64_32
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=14
# Origins allowed to call the API (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Register this account through the UI first, then restart: it is promoted to
# ADMIN on startup, but only while no ADMIN exists yet. This is the only way to
# get the first staff account without editing the database by hand. Afterwards
# an ADMIN can grant roles via PATCH /users/{id}/role.
BOOTSTRAP_ADMIN_EMAIL=

# -------- Frontend (Vite + React) --------
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080

# -------- RAG service (FastAPI + LangChain) --------
RAG_SERVICE_PORT=8000
RAG_EMBEDDING_MODEL=voyage-3
RAG_CHAT_MODEL=claude-opus-5
# Shared secret the backend uses to call the RAG service.
# Generate with: openssl rand -hex 32
RAG_INTERNAL_API_KEY=replace_with_random_hex_32

# -------- Backend -> RAG wiring --------
# Turns on auto-triage on ticket creation and knowledge-base mirroring on
# resolve. With this false the backend never calls the RAG service and tickets
# stay untriaged; nothing else changes. When true, RAG_INTERNAL_API_KEY must be
# set or the backend refuses to start.
RAG_ENABLED=true
# Where the backend reaches the RAG service. Only used when you run the backend
# directly on the host — docker-compose sets this to http://rag-service:8000
# itself, because the address is a property of the compose network rather than
# something you configure.
RAG_SERVICE_URL=http://localhost:8000
